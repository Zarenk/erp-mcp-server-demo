{
  "name": "erp-mcp-server-demo",
  "version": "0.1.0",
  "description": "Read-only MCP server for a small-business ERP: API-key auth, tenant isolation, rate limits, audited tool whitelist.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx src/http.ts",
    "start:stdio": "tsx src/stdio.ts",
    "seed": "tsx src/cli/seed.ts",
    "keys:create": "tsx src/cli/create-key.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
